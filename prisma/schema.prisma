generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Tabela: emprestimo
model Emprestimo {
  emprestimo_id                      Int              @id @default(autoincrement())
  usuario_id                         Int
  emprestimo_data_emprestimo         DateTime?        @db.Date
  emprestimo_data_prevista_devolucao DateTime         @db.Date
  emprestimo_status                  EmprestimoStatus

  itens     ItemEmprestimo[]
  devolucao Devolucao?

  @@map("emprestimo")
}

enum EmprestimoStatus {
  Ativo
  Devolvido
  Atrasado
}

// Tabela: item_emprestimo
model ItemEmprestimo {
  item_emprestimo_id        Int @id @default(autoincrement())
  emprestimo_id             Int
  exemplar_id               Int
  item_emprestimo_quantidade Int @default(1)

  emprestimo Emprestimo @relation(fields: [emprestimo_id], references: [emprestimo_id])

  @@map("item_emprestimo")
}

// Tabela: multa
model Multa {
  multa_id             Int         @id @default(autoincrement())
  multa_valor          Decimal     @db.Decimal(10, 2)
  multa_status         MultaStatus
  multa_data_geracao   DateTime
  multa_data_pagamento DateTime?   @db.Date

  devolucao Devolucao?

  @@map("multa")
}

enum MultaStatus {
  Pendente
  Paga
  Cancelada
}

// Tabela: devolucao
model Devolucao {
  devolucao_id             Int       @id @default(autoincrement())
  emprestimo_id            Int       @unique
  devolucao_data_devolucao DateTime?
  devolucao_atraso_dias    Int       @default(0)
  devolucao_possui_multa   Int       @default(0)
  devolucao_status         Int?
  multa_id                 Int       @unique

  emprestimo Emprestimo @relation(fields: [emprestimo_id], references: [emprestimo_id])
  multa      Multa      @relation(fields: [multa_id], references: [multa_id])

  @@map("devolucao")
}
