generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Emprestimo {
  id           Int       @id @default(autoincrement())
  usuarioId    Int
  livroId      Int
  exemplarId   Int
  status       String    @default("ATIVO") // ATIVO | DEVOLVIDO | ATRASADO
  dataPrazo    DateTime
  dataCriacao  DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  devolucao    Devolucao?
  multa        Multa?

  @@index([usuarioId])
  @@index([livroId])
  @@index([status])
  @@index([status, dataPrazo])
  @@index([dataCriacao])
}

model Devolucao {
  id            Int       @id @default(autoincrement())
  emprestimoId  Int       @unique
  dataDevolucao DateTime
  condicaoLivro String    // BOM | DANIFICADO | PERDIDO
  confirmadoPor Int?
  observacao    String?   @db.Text
  confirmadoEm  DateTime?
  criadaEm      DateTime  @default(now())

  emprestimo    Emprestimo @relation(fields: [emprestimoId], references: [id])

  @@index([emprestimoId])
  @@index([dataDevolucao])
}

model Multa {
  id             Int       @id @default(autoincrement())
  emprestimoId   Int       @unique
  valor          Float
  diasAtraso     Int       @default(0)
  motivo         String    // ATRASO | DANO_LIVRO
  status         String    @default("PENDENTE") // PENDENTE | PAGO | CANCELADO
  formaPagamento String?
  pagoEm         DateTime?
  criadaEm       DateTime  @default(now())

  emprestimo     Emprestimo @relation(fields: [emprestimoId], references: [id])

  @@index([emprestimoId])
  @@index([status])
  @@index([status, criadaEm])
}
